#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Docstring with # inside is a string, not a comment."""
import sys  # noqa: E402
import os  # noqa: E402,F401
import re  # noqa: E402 explained
import json  # noqa
import io  # NOQA:E402

text = "# not a comment"
raw = r'#raw' + '''
# inside a triple-quoted string
'''
name = "wörld😀"
greeting = f"{name!r} # still a string {'#' * 2}"
nested = f"{f'{name} # inner'}"  # trailing comment


def main():
    # inside a function
    return sys, os, re, json, io, text, raw, greeting, nested  # type: ignore
