[Unit]
Description=sshd -i sessions multiplexed on serial line %I (dsh)
After=sshd-keygen.service
ConditionPathExists=/dev/%I

[Service]
ExecStart=/usr/bin/python3 -I /usr/local/sbin/dsh-serial-relay /dev/%I
RuntimeDirectory=sshd
RuntimeDirectoryPreserve=yes
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
