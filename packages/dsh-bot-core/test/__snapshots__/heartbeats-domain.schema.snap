{
  "name": "dsh_bot_heartbeats",
  "version": 1,
  "tables": {
    "settings": {
      "enabled": {
        "required": true,
        "type": "boolean"
      },
      "intervalMinutes": {
        "required": true,
        "type": "number"
      },
      "activeHours": {
        "required": false,
        "type": "{ start: string; end: string }"
      }
    }
  }
}
