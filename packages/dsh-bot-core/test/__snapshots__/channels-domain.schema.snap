{
  "name": "dsh_bot_channels",
  "version": 1,
  "tables": {
    "channels": {
      "botId": {
        "required": true,
        "type": "string"
      },
      "channelId": {
        "required": true,
        "type": "string"
      },
      "enabled": {
        "required": true,
        "type": "boolean"
      },
      "values": {
        "required": true,
        "type": "{ [key: string]: string | string[] }"
      },
      "secrets": {
        "required": true,
        "type": "string[]"
      },
      "settingsVersion": {
        "required": false,
        "type": "number"
      },
      "profileSync": {
        "required": false,
        "type": "boolean"
      },
      "updatedAt": {
        "required": true,
        "type": "number"
      }
    }
  }
}
