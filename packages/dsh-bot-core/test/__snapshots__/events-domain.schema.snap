{
  "name": "dsh_bot_connector_events",
  "version": 1,
  "tables": {
    "events": {
      "id": {
        "required": true,
        "type": "string"
      },
      "botId": {
        "required": true,
        "type": "string"
      },
      "connectorId": {
        "required": true,
        "type": "string"
      },
      "connectionId": {
        "required": true,
        "type": "string"
      },
      "key": {
        "required": true,
        "type": "string"
      },
      "kind": {
        "required": true,
        "type": "string"
      },
      "occurredAt": {
        "required": true,
        "type": "number"
      },
      "receivedAt": {
        "required": true,
        "type": "number"
      },
      "summary": {
        "required": true,
        "type": "string"
      },
      "ref": {
        "required": true,
        "type": "string | number | boolean | null | json[] | { [key: string]: json }"
      },
      "own": {
        "required": true,
        "type": "boolean"
      },
      "gap": {
        "required": true,
        "type": "boolean"
      },
      "state": {
        "required": true,
        "type": "\"new\" | \"notified\" | \"acked\""
      }
    },
    "cursors": {
      "connectionId": {
        "required": true,
        "type": "string"
      },
      "connectorId": {
        "required": true,
        "type": "string"
      },
      "cursor": {
        "required": true,
        "type": "string | number | boolean | null | json[] | { [key: string]: json }"
      },
      "updatedAt": {
        "required": true,
        "type": "number"
      }
    }
  }
}
