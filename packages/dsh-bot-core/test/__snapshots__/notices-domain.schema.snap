{
  "name": "dsh_bot_notices",
  "version": 8,
  "tables": {
    "notices": {
      "botId": {
        "required": true,
        "type": "string"
      },
      "topic": {
        "required": true,
        "type": "\"connector\" | \"schedule\" | \"event\" | \"file\" | \"session\" | \"heartbeat\" | \"peer\" | \"peer-status\" | \"peer-session\" | \"space\""
      },
      "messageId": {
        "required": true,
        "type": "string"
      },
      "text": {
        "required": true,
        "type": "string"
      },
      "summary": {
        "required": true,
        "type": "string"
      },
      "peerMessages": {
        "required": false,
        "type": "string[]"
      },
      "space": {
        "required": false,
        "type": "{ spaceId: string; public: boolean; events: number }"
      },
      "createdAt": {
        "required": true,
        "type": "number"
      }
    }
  }
}
