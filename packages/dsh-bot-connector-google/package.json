{
  "name": "@1outres/dsh-bot-connector-google",
  "version": "0.3.1",
  "description": "Gives the bots of DeepSeek Harness their owner's Gmail and Google Calendar: tools that read and act as the Google accounts assigned to each bot, sending and other outside actions only after the owner approves, and new emails and calendar changes as events.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1outres/dsh-bots.git",
    "directory": "packages/dsh-bot-connector-google"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/build.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "bot",
    "connector",
    "gmail",
    "google-calendar",
    "deepseek-harness"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": "0.2.2-rc.5",
    "node": ">=22"
  },
  "peerDependencies": {
    "@1outres/dsh-bot-core": "workspace:^0.3.1",
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@1outres/dsh-bot-core": "workspace:*",
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "@googleapis/calendar": "^20.2.0",
    "@googleapis/gmail": "^22.1.0",
    "google-auth-library": "^11.3.4"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    }
  }
}
