{
  "name": "dsh_bot_discord",
  "version": 4,
  "tables": {
    "cards": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "botId": {
          "type": "string",
          "minLength": 1
        },
        "actionId": {
          "type": "string",
          "minLength": 1
        },
        "channelId": {
          "type": "string",
          "pattern": "^[0-9]{17,20}$"
        },
        "messageId": {
          "type": "string",
          "pattern": "^[0-9]{17,20}$"
        }
      },
      "required": [
        "botId",
        "actionId",
        "channelId",
        "messageId"
      ],
      "additionalProperties": false
    },
    "digests": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "botId": {
          "type": "string",
          "minLength": 1
        },
        "channelId": {
          "type": "string",
          "pattern": "^[0-9]{17,20}$"
        },
        "messageId": {
          "type": "string",
          "pattern": "^[0-9]{17,20}$"
        },
        "pin": {
          "type": "string",
          "enum": [
            "due",
            "pinned",
            "abandoned"
          ]
        }
      },
      "required": [
        "botId",
        "channelId",
        "messageId",
        "pin"
      ],
      "additionalProperties": false
    },
    "incidents": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "botId": {
          "type": "string",
          "minLength": 1
        },
        "incidentId": {
          "type": "string",
          "minLength": 1
        },
        "channelId": {
          "type": "string",
          "pattern": "^[0-9]{17,20}$"
        },
        "messageId": {
          "type": "string",
          "pattern": "^[0-9]{17,20}$"
        }
      },
      "required": [
        "botId",
        "incidentId",
        "channelId",
        "messageId"
      ],
      "additionalProperties": false
    },
    "profiles": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "botId": {
          "type": "string",
          "minLength": 1
        },
        "userId": {
          "type": "string",
          "pattern": "^[0-9]{17,20}$"
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "avatar": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "botId",
        "userId"
      ],
      "additionalProperties": false
    }
  }
}