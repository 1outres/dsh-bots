{
  "name": "@1outres/dsh-bot-vm",
  "version": "0.4.2",
  "description": "Runs every bot of DeepSeek Harness in its own VM (Incus or Proxmox VE): bot Agents read, write and execute there over SSH instead of on the Host.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1outres/dsh-bots.git",
    "directory": "packages/dsh-bot-vm"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./ssh": "./lib/ssh.js",
    "./full-access-policy": "./lib/full-access-policy.js",
    "./fs": "./lib/fs.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/build.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "bot",
    "vm",
    "incus",
    "ssh",
    "deepseek-harness"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": "0.2.2-rc.5",
    "node": ">=22"
  },
  "peerDependencies": {
    "@1outres/dsh-bot-core": "workspace:^0.4.2",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.5",
    "@deepseek-ai/dsh-util-ripgrep": "0.2.2-rc.5"
  },
  "devDependencies": {
    "@1outres/dsh-bot-core": "workspace:*",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-fs-ssh": "0.2.2-rc.5",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.5",
    "@deepseek-ai/dsh-ssh": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subprocess-ssh": "0.2.2-rc.5",
    "@deepseek-ai/dsh-util-ripgrep": "0.2.2-rc.5"
  },
  "dependencies": {
    "@deepseek-ai/dsh-fs-ssh": "0.2.2-rc.5",
    "@deepseek-ai/dsh-ssh": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subprocess-ssh": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "~3.19.0",
    "zod": "4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    }
  }
}
