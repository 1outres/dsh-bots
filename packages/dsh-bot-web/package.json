{
  "name": "@1outres/dsh-bot-web",
  "version": "0.4.1",
  "description": "Searches the web and fetches pages for every bot of DeepSeek Harness through Exa, with the bots' own Exa API key, kept apart from the Host's web settings.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1outres/dsh-bots.git",
    "directory": "packages/dsh-bot-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/build.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "bot",
    "web",
    "search",
    "exa",
    "deepseek-harness"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": "0.2.2-rc.5",
    "node": ">=22"
  },
  "peerDependencies": {
    "@1outres/dsh-bot-core": "workspace:^0.4.1",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-web": "0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    }
  },
  "devDependencies": {
    "@1outres/dsh-bot-core": "workspace:*",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-web": "0.2.2-rc.5"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  }
}
