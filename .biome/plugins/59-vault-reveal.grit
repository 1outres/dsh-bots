or {
  JsStaticMemberExpression(member = $member) as $found where {
    $member <: r"reveal|passkey"
  },
  JsObjectBindingPatternShorthandProperty(identifier = $binding) as $found where {
    $binding <: r"reveal|passkey"
  },
  JsObjectBindingPatternProperty(member = $member) as $found where {
    $member <: r"reveal|passkey"
  }
} where {
  register_diagnostic(
    span = $found,
    message = "Design rule 59: do not reach a password manager's reveal or passkey here; go through host/vaults/access.ts, which checks the login, records the use and fingerprints the value first."
  )
}
