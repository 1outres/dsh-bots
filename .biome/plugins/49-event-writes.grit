JsCallExpression(callee = $callee) as $call where {
  $callee <: or { `$receiver.put`, `$receiver.delete`, `$receiver?.put`, `$receiver?.delete` },
  $receiver <: or { `events`, `$_.events`, `$_?.events`, `cursors`, `$_.cursors`, `$_?.cursors` },
  register_diagnostic(
    span = $call,
    message = "Design rule 49: do not write the events tables here; go through the event store (host/events/store.ts), which stores events before their cursor moves."
  )
}
