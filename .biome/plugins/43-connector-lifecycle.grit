JsCallExpression(callee = $callee) as $call where {
  or {
    and {
      $callee <: or { `$receiver.prepare`, `$receiver.unprepare`, `$receiver?.prepare`, `$receiver?.unprepare` },
      $receiver <: or { `preparation`, `$_.preparation`, `$_?.preparation` }
    },
    and {
      $callee <: or { `$receiver.open`, `$receiver?.open` },
      $receiver <: or { `attachment`, `$_.attachment`, `$_?.attachment` }
    }
  },
  register_diagnostic(
    span = $call,
    message = "Design rule 43: do not run a connector's preparation or open its resident resource here; go through host/connectors/readiness.ts (preparations, one bot at a time) or host/connectors/attachments.ts (one resource per bot and connector)."
  )
}
