// Design rule 31: the browser half does not touch document.body.
// The page belongs to DSH; render through slots and portals the UI gives.
// client/hide-picker-workspaces.ts is excluded in biome.json: the workspace
// picker menus are portaled straight under <body> and offer no slot.
`document.body` as $body where {
  register_diagnostic(
    span = $body,
    message = "Design rule 31: do not use document.body; render through DSH slots or the renderer's portal, because the page and its body belong to DSH."
  )
}
