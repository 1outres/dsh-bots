JsCallExpression(callee = $callee) as $call where {
  $callee <: or { `$receiver.put`, `$receiver.delete`, `$receiver?.put`, `$receiver?.delete` },
  $receiver <: or { `connections`, `$_.connections`, `$_?.connections`, `grants`, `$_.grants`, `$_?.grants`, `clients`, `$_.clients`, `$_?.clients` },
  register_diagnostic(
    span = $call,
    message = "Design rule 48: do not write the connections tables here; go through the connection store (host/connections/store.ts), which keeps accounts, their bots and the OAuth client ids consistent."
  )
}
