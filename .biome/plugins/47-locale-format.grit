or {
  `$_.toLocaleString`, `$_?.toLocaleString`,
  `$_.toLocaleDateString`, `$_?.toLocaleDateString`,
  `$_.toLocaleTimeString`, `$_?.toLocaleTimeString`,
  `Intl.DateTimeFormat`, `Intl.RelativeTimeFormat`, `Intl.PluralRules`,
  `Intl.NumberFormat`, `Intl.DurationFormat`
} as $format where {
  register_diagnostic(
    span = $format,
    message = "Design rule 47: do not format dates, times or counts here; use localeFormat(t) from client/locale-format.ts, so they follow the DSH language of the messages instead of the browser's default locale."
  )
}
