// Design rule 64: a secret reaches a bot's VM only on a running process's standard input.
// Inside the callback of `$secret.use(...)` in connectors, nothing may start a command
// (its argv and environment are logged and visible), write a file, read the environment
// or log: `exec`, `spawn`, `writeFile`, `console.*` and `process.env` are refused there.
JsCallExpression(callee = $callee, arguments = $arguments) where {
  $callee <: or { `$_.use`, `$_?.use` },
  $arguments <: contains or {
    JsCallExpression(callee = or { `$_.exec`, `$_.spawn`, `$_.writeFile`, `console.$_` }),
    `process.env`
  } as $bad,
  register_diagnostic(
    span = $bad,
    message = "Design rule 64: inside SecretBytes.use() a connector writes the bytes to an already running process's stdin only; start the process, build argv, env and files before use()."
  )
}
