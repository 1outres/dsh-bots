JsCallExpression(callee = $callee, arguments = $arguments) where {
  $callee <: or { `$_.use`, `$_?.use` },
  $arguments <: contains or {
    JsCallExpression(callee = or { `$_.exec`, `$_.spawn`, `$_.writeFile`, `console.$_` }),
    `process.env`
  } as $bad,
  register_diagnostic(
    span = $bad,
    message = "Design rule 64: inside SecretBytes.use() a connector writes the bytes to an already running process's stdin only; start the process, build argv, env and files before use()."
  )
}
