// Design rule 34: tools are registered only inside a bot's own composition.
// `tools.register(...)` may appear only in bot-core's channel, connectors,
// schedule, notes and skills rows (src/plugins/channel.ts, src/plugins/connectors.ts,
// src/plugins/schedule.ts, src/plugins/notes.ts, src/plugins/skills.ts), which run inside every bot's isolated group: a
// tool registered anywhere else is a Host (global) tool, which isolation
// hides from bot Agents unless a template's hostTools grants it.
JsCallExpression(callee = $callee) as $call where {
  $callee <: or { `$receiver.register`, `$receiver?.register` },
  $receiver <: or { `tools`, `$_.tools`, `$_?.tools` },
  register_diagnostic(
    span = $call,
    message = "Design rule 34: do not call tools.register() here; a bot's tools come from rows inside its preset group (bot-core's src/plugins/channel.ts), because a tool registered elsewhere runs on the Host as a global tool."
  )
}
