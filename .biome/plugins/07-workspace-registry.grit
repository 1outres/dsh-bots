JsCallExpression(callee = $callee) as $call where {
  $callee <: or {
    `$receiver.create`, `$receiver.delete`, `$receiver.archiveSession`,
    `$receiver?.create`, `$receiver?.delete`, `$receiver?.archiveSession`
  },
  $receiver <: or { `workspaceRegistry`, `$_.workspaceRegistry`, `$_?.workspaceRegistry` },
  register_diagnostic(
    span = $call,
    message = "Design rule 7: do not create, delete or archive through workspaceRegistry here; inject the call from src/index.ts or use cleanupBotSessions() (host/cleanup.ts), so bot sessions keep one lifecycle."
  )
}
