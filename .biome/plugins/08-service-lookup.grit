JsCallExpression(callee = $callee) as $call where {
  $callee <: or { `$receiver.get`, `$receiver?.get` },
  $receiver <: or { `ctx`, `$_.ctx`, `$_?.ctx` },
  register_diagnostic(
    span = $call,
    message = "Design rule 8: do not look services up with ctx.get(); use the typed accessor botOf(ctx) from contract.ts, which names the service once and fails with a clear message."
  )
}
