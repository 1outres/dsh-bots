or { TsPropertySignatureTypeMember(), TsIndexSignatureTypeMember() } as $member where {
  not $member <: r"(?s)readonly\b.*",
  register_diagnostic(
    span = $member,
    message = "Design rule 29: mark this shared property readonly; shapes under src/shared/ cross the Host/browser boundary and are stored, so nothing may mutate them in place."
  )
}
