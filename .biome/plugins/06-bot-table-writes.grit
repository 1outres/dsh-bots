JsCallExpression(callee = $callee) as $call where {
  $callee <: or { `$receiver.put`, `$receiver.delete`, `$receiver?.put`, `$receiver?.delete` },
  $receiver <: or { `table`, `$_.table`, `$_?.table` },
  register_diagnostic(
    span = $call,
    message = "Design rule 6: do not write the bots table here; go through the bot registry (host/registry.ts), which serializes writes and notifies its subscribers."
  )
}
