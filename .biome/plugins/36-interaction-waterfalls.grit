JsCallExpression(callee = $callee, arguments = $arguments) as $call where {
  $callee <: or { `$_.on`, `$_?.on`, `on` },
  $arguments <: contains JsStringLiteralExpression() as $event where {
    $event <: r"[\"'](?:user-questions|approval)/request[\"']"
  },
  register_diagnostic(
    span = $call,
    message = "Design rule 36: do not listen to DSH's question or approval waterfall here; bot-core's answerers (host/interactions/answerers.ts, wired in src/index.ts) own them, because they must claim only bot sessions' requests and pass every other Agent's on."
  )
}
