JsCallExpression(callee = $callee) as $call where {
  $callee <: or { `$receiver.put`, `$receiver.delete`, `$receiver?.put`, `$receiver?.delete` },
  $receiver <: or { `models`, `$_.models`, `$_?.models` },
  register_diagnostic(
    span = $call,
    message = "Design rule 51: do not write the model roles table here; go through the model store (host/models/store.ts)."
  )
}
