`class $name extends $base { $body }` where {
  $base <: or { `TypertRemoteService`, `$_.TypertRemoteService` },
  $body <: contains JsMethodClassMember(name = $method) as $member where { $method <: `remove` },
  register_diagnostic(
    span = $member,
    message = "Design rule 21: do not name a TypertRemoteService method remove; pick a specific name such as removeBot, because the browser namespace service already owns remove."
  )
}
