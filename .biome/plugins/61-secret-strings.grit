// Design rule 61: a secret's bytes never become a JS string or leave as a view.
// `$secret.use(...)` (SecretBytes) takes an inline function, and inside it, in
// bot-core's vault code and in connectors, nothing may turn bytes into text or
// keep a view of them: TextDecoder, `.decode()`, `.toString()`, `String()`,
// `JSON.stringify()`, `String.fromCharCode()`, `.join()`, `Array.from()`,
// `Buffer.from()`, `.slice()`, `.subarray()` and template literals are refused
// there (copy with `new Uint8Array(bytes)`).
JsCallExpression(callee = $callee, arguments = $arguments) where {
  $callee <: or { `$_.use`, `$_?.use` },
  or {
    $arguments <: JsCallArguments(args = [JsIdentifierExpression() as $bad]),
    $arguments <: JsCallArguments(args = [JsStaticMemberExpression() as $bad]),
    $arguments <: contains or {
      JsNewExpression(callee = `TextDecoder`),
      JsCallExpression(
        callee = or {
          `$_.decode`,
          `$_.toString`,
          `String`,
          `JSON.stringify`,
          `String.fromCharCode`,
          `$_.join`,
          `Array.from`,
          `Buffer.from`,
          `$_.slice`,
          `$_.subarray`
        }
      ),
      JsTemplateExpression()
    } as $bad
  },
  register_diagnostic(
    span = $bad,
    message = "Design rule 61: pass SecretBytes.use() an inline function that neither turns the bytes into a string nor keeps a view of them; copy with new Uint8Array(bytes) and let them be wiped."
  )
}
