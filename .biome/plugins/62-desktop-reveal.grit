JsCallExpression(callee = $callee) as $call where {
  $callee <: or { `$_.reveal`, `$_?.reveal`, `$_.passkey`, `$_?.passkey` },
  register_diagnostic(
    span = $call,
    message = "Design rule 62: only host/tools/credentials.ts of the desktop connector reveals a login (run.vault.reveal / passkey); type logins with desktop_type_credential."
  )
}
