JsCallExpression(callee = $callee, arguments = $arguments) as $call where {
  $callee <: or { `$_.on`, `$_?.on`, `on` },
  $arguments <: contains JsStringLiteralExpression() as $event where {
    $event <: r"[\"']agent/created[\"']"
  },
  register_diagnostic(
    span = $call,
    message = "Design rule 4: do not listen to \"agent/created\" here; tool isolation (host/preset/isolation.ts) owns that event, because a throw from its listener rolls the Agent back."
  )
}
