or {
  JsReferenceIdentifier(),
  JsIdentifierBinding(),
  JsName(),
  JsLiteralMemberName(),
  JsStringLiteralExpression()
} as $name where {
  $name <: r"[\"']?sessionQuery[\"']?",
  register_diagnostic(
    span = $name,
    message = "Design rule 55: do not use DSH's sessionQuery here; it checks no caller, so only bot-core's src/index.ts wires it, and host/conversations/ decides from bot-core's records which sessions a bot may read."
  )
}
