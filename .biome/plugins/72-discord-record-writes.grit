JsCallExpression(callee = $callee) as $call where {
  $callee <: or { `$receiver.put`, `$receiver.delete`, `$receiver?.put`, `$receiver?.delete` },
  $receiver <: or {
    `cards`, `$_.cards`, `$_?.cards`,
    `digests`, `$_.digests`, `$_?.digests`,
    `incidents`, `$_.incidents`, `$_?.incidents`
  },
  register_diagnostic(
    span = $call,
    message = "Design rule 72: do not write the Discord channel's records here; go through host/actions/records.ts (approval cards and lists) or host/incidents/records.ts (which owner was shown which credential incident)."
  )
}
