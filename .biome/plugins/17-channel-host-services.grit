// Design rule 17: channel plugins stay away from the Host services bot-core owns.
// In packages/dsh-bot-* other than dsh-bot-core, the names sessionController,
// agentPresets, workspaceRegistry and credentials must not appear (identifiers,
// property names or strings such as an `inject` entry): bot-core delivers to
// a bot's Main session and keeps a channel's secrets for it.
or {
  JsReferenceIdentifier(),
  JsIdentifierBinding(),
  JsName(),
  JsLiteralMemberName(),
  JsStringLiteralExpression()
} as $name where {
  $name <: r"[\"']?(?:sessionController|agentPresets|workspaceRegistry|credentials)[\"']?",
  register_diagnostic(
    span = $name,
    message = "Design rule 17: channel plugins must not use sessionController, agentPresets, workspaceRegistry or credentials; call the bot service (botOf(ctx)) instead, which keeps bot sessions under their preset and isolation and a channel's secrets in its settings."
  )
}
