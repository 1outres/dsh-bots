// Design rule 65: the browser connector fetches a login's value in one place.
// `reveal(…)` and `passkey(…)` of a run's vault access are called only by
// src/host/vault/tools.ts, which reveals for the origin the helper located in
// the browser and hands the value to the helper's stdin.
JsCallExpression(callee = or { `$_.reveal`, `$_?.reveal`, `$_.passkey`, `$_?.passkey` }) as $call where {
  register_diagnostic(
    span = $call,
    message = "Design rule 65: only src/host/vault/tools.ts reveals a login's value in the browser connector (for the origin the helper located)."
  )
}
