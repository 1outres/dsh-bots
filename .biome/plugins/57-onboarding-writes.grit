JsCallExpression(callee = $callee) as $call where {
  $callee <: or { `$receiver.put`, `$receiver.delete`, `$receiver?.put`, `$receiver?.delete` },
  $receiver <: or { `onboardingState`, `$_.onboardingState`, `$_?.onboardingState` },
  register_diagnostic(
    span = $call,
    message = "Design rule 57: do not write the onboarding state table here; go through the onboarding store (host/onboarding/store.ts), which serializes every change."
  )
}
