      "includes": [".biome/plugins/**"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["packages/dsh-bot-*/**", "!packages/dsh-bot-core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@1outres/*/src",
                      "@1outres/*/src/**",
                      "@1outres/*/lib",
                      "@1outres/*/lib/**",
                      "**/dsh-bot-*/src/**",
                      "**/dsh-bot-*/lib/**"
                    ],
                    "message": "Design rule 15: do not import another package's src/ or lib/; import its public entry (e.g. @1outres/dsh-bot-core), because internal paths change without notice."
                  },
                  {
                    "group": [
                      "@deepseek-ai/dsh-api-session-controller",
                      "@deepseek-ai/dsh-api-session-controller/**",
                      "@deepseek-ai/dsh-agent-preset-registry",
                      "@deepseek-ai/dsh-agent-preset-registry/**",
                      "@deepseek-ai/dsh-tools",
                      "@deepseek-ai/dsh-tools/**",
                      "@deepseek-ai/dsh-credentials",
                      "@deepseek-ai/dsh-credentials/**"
                    ],
                    "message": "Design rule 16: channel plugins must not import DSH session, preset, tool or credential services; use the bot service (botOf(ctx)), which keeps bot sessions under their preset and isolation and a channel's secrets in its settings."
                  }
                ]
              }
            }
          }
        }
      }
    },
