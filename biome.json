{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!pnpm-lock.yaml", "!test/fixtures/lint"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "@1outres/*/src",
                  "@1outres/*/src/**",
                  "@1outres/*/lib",
                  "@1outres/*/lib/**",
                  "**/dsh-bot-*/src/**",
                  "**/dsh-bot-*/lib/**"
                ],
                "message": "Design rule 15: do not import another package's src/ or lib/; import its public entry (e.g. @1outres/dsh-bot-core), because internal paths change without notice."
              }
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
