                  {
                    "group": [
                      "node:fs",
                      "node:fs/**",
                      "fs",
                      "fs/**",
                      "node:child_process",
                      "child_process"
                    ],
                    "message": "Design rule 35: a channel plugin must not touch the Host's file system or processes; attachments reach the bot through deliver() (bot-core saves them in the bot's environment) and files leave as the 'file' outputs bot-core sends for what the Main session presents, because a bot's files live only in its environment."
                  },
                  {
                    "group": [
                      "discord.js",
                      "discord.js/**",
                      "@discordjs/*",
                      "@discordjs/*/**",
                      "discord-api-types",
                      "discord-api-types/**"
                    ],
                    "message": "Design rule 33: only the discord.js adapter (src/host/discordjs/) may import discord.js and its packages; the channel's logic uses the plain contract in src/host/discord.ts, so it stays testable and the library stays replaceable."
                  }
