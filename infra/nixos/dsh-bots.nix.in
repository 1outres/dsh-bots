# Written by the dsh-bots installer (infra/nixos/dsh-bots.nix.in) for @DSH_USER@.
# Import it in your NixOS configuration and run nixos-rebuild switch; then run
# the installer again. What infra/vm/host-setup.sh's packages, firewall and
# workspaces phases do on other systems, declared here.
{ pkgs, ... }:
{
  virtualisation.incus.enable = true;
  # The NixOS Incus module requires the nftables backend.
  networking.nftables.enable = true;
  # DHCP and DNS of the bot VMs reach the host through the NixOS firewall; the
  # Incus network ACL still rejects everything else from them to the host.
  networking.firewall.trustedInterfaces = [ "dshbr0" ];

  users.users.@DSH_USER@.extraGroups = [ "incus-admin" ];
  environment.systemPackages = [ pkgs.socat pkgs.btrfs-progs pkgs.zstd ];
  boot.kernelModules = [ "vhost_vsock" ];

  # The bots' shared workspaces: a self bind mount, so that what a bot writes
  # (setuid files, device nodes, symlinks) stays inert on the host. Bot VMs
  # autostart with Incus and must never share from it unmounted.
  systemd.mounts = [
    {
      description = "dsh-bots: bots' shared workspaces (nosuid,nodev,nosymfollow)";
      what = "@BOTS_ROOT@";
      where = "@BOTS_ROOT@";
      type = "none";
      options = "bind,nosuid,nodev,nosymfollow";
      before = [ "incus.service" ];
      wantedBy = [ "local-fs.target" ];
    }
  ];
  systemd.services.incus.unitConfig.RequiresMountsFor = [ "@BOTS_ROOT@" ];
}
