# What install.sh installs (sourced by infra/vm/lib.sh). DSH_BOTS_VERSION and DSH_VERSION
# equal packages/dsh-bots/package.json's version and engines.dsh (test/installer.test.ts);
# infra/vm/export-image.sh sets IMAGE_TAG and IMAGE_MANIFEST_SHA256. A piped install reads
# this file from the latest release; the release workflow checks it (infra/RELEASING.md).
DSH_BOTS_VERSION=0.3.0
DSH_VERSION=0.2.2-rc.5
IMAGE_TAG=
IMAGE_MANIFEST_SHA256=
